      "rd /s*": "deny",
      "rmdir /s*": "deny",
      "Remove-Item*-Recurse*": "deny",
      "Set-ExecutionPolicy*": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "rsync *": "deny",
      "pm2 *": "deny",
      "sudo *": "deny"
    },
